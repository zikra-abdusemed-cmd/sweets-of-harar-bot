# Create this with BotFather.
TELEGRAM_BOT_TOKEN=123456:replace_me

# Comma-separated Telegram numeric user IDs. Use /whoami in the bot to find yours.
ADMIN_TELEGRAM_IDS=123456789

# Recommended: create a Google Sheet, share it with the service account email,
# then paste the spreadsheet ID here.
SPREADSHEET_ID=

# Optional: if SPREADSHEET_ID is empty, the bot can create a sheet and share it
# with this email at startup. Paste the printed sheet ID back into .env afterward.
ADMIN_EMAIL=you@example.com

# Path to the downloaded Google service-account JSON key.
GOOGLE_SERVICE_ACCOUNT_JSON=service-account.json

# Optional display settings.
BUSINESS_NAME=Home Bakery
CURRENCY=ETB
